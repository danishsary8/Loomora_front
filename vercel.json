{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "feat/QA-021-cross-browser-release-regression": false,
      "feat/QA-022-staging-integration-prep": false,
      "feat/F-031-guest-repeat-capacity": false,
      "feat/QA-023-r2-parity": false,
      "v2-rebuild": false
    }
  },
  "rewrites": [
    {
      "source": "/((?!api$|api/|assets$|assets/|sw\\.js$|manifest\\.webmanifest$|workbox-[^/]+\\.js$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-f5dF16tVBt10PewzxCqqrvCGvvv2PnzQeGugOFK59oQ='; img-src 'self'; font-src 'self'; connect-src 'self' https://loomora-api.onrender.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/([Aa][Uu][Tt][Hh]/[Gg][Oo][Oo][Gg][Ll][Ee]/[Dd][Ee][Ll][Ee][Tt][Ii][Oo][Nn]/[Cc][Aa][Ll][Ll][Bb][Aa][Cc][Kk]/*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
